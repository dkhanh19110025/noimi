# Địa chỉ web dùng để tạo mã QR (đổi sang tên miền thật khi chốt)
SITE_URL=https://linhhue.vercel.app

# Chỉ server — KHÔNG đặt tiền tố NEXT_PUBLIC_, KHÔNG commit giá trị thật
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin: mật khẩu tự đặt (dài, khó đoán) và chuỗi ngẫu nhiên >= 32 ký tự
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Gmail SMTP gui mail xac nhan don (Google Account > Bao mat > Mat khau ung dung)
GMAIL_USER=
GMAIL_APP_PASSWORD=
